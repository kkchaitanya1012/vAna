# Voice providers (M1 needs Deepgram, OpenRouter, Cartesia; Daily optional)
# Model: VANA_LLM_MODEL (OpenRouter id, e.g. a ":free" model or "anthropic/claude-haiku-5-5")
DAILY_API_KEY=
DEEPGRAM_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
# Added in M6
OPENAI_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
GROQ_API_KEY=
SONIOX_API_KEY=
GLADIA_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=
SMALLEST_API_KEY=

# Langfuse (local UI at http://localhost:3001; create project, copy keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# App infra
DATABASE_URL=postgresql+asyncpg://vana:vana@localhost:5432/vana
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=vana-audio
S3_ACCESS_KEY=vana
S3_SECRET_KEY=vana-secret-change-me
VOICE_URL=http://localhost:8100

# Shared secret between the API and the voice server. When set, the voice server's /start and /stop and the API's
# event and audio-upload routes reject calls without it. Leave empty for local dev; set a long random value when public.
VANA_INTERNAL_TOKEN=

# Optional extensions: comma-separated module names, each with setup(app). Leave empty for the stock app.
VANA_EXTENSIONS=
# Web app only: if set, visitors without the cookie named below are redirected to this URL (an extension provides it).
VANA_SIGNIN_URL=
VANA_SIGNIN_COOKIE=vana_signin
